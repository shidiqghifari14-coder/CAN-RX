#include <ESP32_CAN.h>
#include <circular_buffer.h>
#include <isotp.h>
#include <BluetoothSerial.h>

//define address  
#define Motor_Controller 0xEF // Hexa dari 239
#define BMS 0xF4              // Hexa dari 244
#define CCS 0xE5              // Hexa dari 229
#define BCA 0x50              // Hexa dari 80

//define message id 
#define Message_1_CAN_ID 0x1806E5F4 // BMS out, CCS in //Transmit
#define Message_2_CAN_ID 0x18FF50E5 // CCS out, BCA in //Recieve

//Transmit
uint8_t Vsetmsb = 15;
uint8_t Vsetlsb = 160;
uint16_t Vset = 0;
uint8_t Isetmsb = 0; 
uint8_t Isetlsb = 60; //Tinggal buat fungsi baru untuk nanti bisa request ampere
uint16_t Iset = 0;
uint8_t Control = 0; //Buat start dan stop charging


//Recieve
//Byte 1 2
uint8_t Voutmsb = 0;
uint8_t Voutlsb = 0;
uint16_t Vout = 0;
//Byte 3 4
uint8_t Ioutmsb = 0;
uint8_t Ioutlsb = 0;
uint16_t Iout = 0;
//Byte 5 
uint8_t status_flags = 0;

bool hwFault        = false;
bool tempFault      = false;
bool inputVoltFault = false;
bool startFault     = false; //Diawal pasti ini 1 karena battery belum connected fusenya
bool commFault      = false;

uint16_t data[2][8];
ESP32_CAN<RX_SIZE_256, TX_SIZE_16> Can0;
BluetoothSerial BT;

void nigerCallback(const CAN_message_t &msg) {
   if(msg.id == Message_2_CAN_ID){
    BT.print(" Can Started");
    BT.print(" ID: "); BT.print(msg.id, HEX);
    {
    for ( uint8_t i = 0; i < msg.len; i++ ) { 
        BT.print(msg.buf[i], HEX); BT.print(" ");
        data[0][i] = msg.buf[i];
      }BT.println();
    }
  }
  else{
    BT.println("Eror........");
  }
}

void sendChargerRequest(){    //Void untuk transmit nanti panggil di loop atau set up
  CAN_message_t tx_msg;
  tx_msg.id = Message_1_CAN_ID;
  tx_msg.len = 8;
  tx_msg.flags.extended = 1;

// Kirim langsung gausah shifting
  tx_msg.buf[0] = Vsetmsb;
  tx_msg.buf[1] = Vsetlsb;
  tx_msg.buf[2] = Isetmsb;
  tx_msg.buf[3] = Isetlsb;
//Control charging
  tx_msg.buf[4] = 0; //Start Charging
  tx_msg.buf[5] = 0; //Charging Mode

  Can0.write(tx_msg);
  BT.print("Tx sent!");
}

void handleBTInput(){
  if(BT.available() > 0){
    char input = BT.read();
    if(input >= '1' && input <= '6' ){
      int Isetlsb = input - '0';  //masih bingung aku
      BT.print("Current Set: ");
      BT.print(Isetlsb);
      BT.print("A");
    }
  }
}

void setup() {
  BT.begin(115200);
  delay(1000);
  
  BT.println("CAN Bus Started");
  BT.println("Initializing CAN...");
  Can0.setRX(21);
  Can0.setTX(22);
  Can0.onReceive(nigerCallback);
  
  Can0.begin();          
    Can0.setBaudRate(250000);
    BT.println("CAN Initialization SUCCESS");
    BT.println("Type 1-6 to request Current");
    BT.println("Stop At 400V");
}

void loop() {
handleBTInput();

//millis untuk kirim data(TX) tiap 1 detik
static uint32_t t = millis();
if(millis() - t > 1000){
  sendChargerRequest();
  t = millis();
}


   Voutmsb = data[0][0]; 
   Voutlsb = data[0][1];
    Vout = (Voutmsb << 8) | Voutlsb;  
   BT.println();
    Ioutmsb = data[0][2];
    Ioutlsb = data[0][3];
    Iout = (Ioutmsb << 8) | Ioutlsb;
       status_flags = data[0][4];
       hwFault        = bitRead(status_flags, 0);
       tempFault      = bitRead(status_flags, 1);
       inputVoltFault = bitRead(status_flags, 2);
       startFault     = bitRead(status_flags, 3);
       commFault      = bitRead(status_flags, 4);

     BT.print("Voltage: ");
     BT.print(Vout);
     BT.print("Current: ");
     BT.print(Iout);

     if(hwFault == 0 && tempFault == 0 && inputVoltFault == 0 && startFault == 0 && commFault == 0){
      BT.println("STATUS OK -> Charge Allowed");
     }
      else{
        BT.println("STATUS FAULT -> Charge not Allowed");
      }

    if(Vout == 4000 && Control == 0){
      Control = 1;
      BT.print("STOP CHARGING");
    }

}
