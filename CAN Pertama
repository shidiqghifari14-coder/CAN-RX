//Byte 5 6
uint8_t control_1;
uint8_t control_2;

uint16_t data[2][8];
ESP32_CAN<RX_SIZE_256, TX_SIZE_16> Can0;

void nigerCallback(const CAN_message_t &msg) {
  if (msg.id == Message_2_CAN_ID) {
    for (uint8_t i = 0; i < msg.len && i < 8; i++) {
      rxBuffer[i] = msg.buf[i];
    }
    newDataReceived = true;
  }

