void setup() {
  Serial.begin(115200);
  delay(500);
  
  Serial.println("CAN Bus Started Recieve");
  Serial.println("Initializing CAN...");
  Can0.setRX(21);
  Can0.setTX(22);
  Can0.onReceive(nigerCallback);
  
  Can0.begin();          
    Can0.setBaudRate(250000);
    Serial.println("CAN Initialization SUCCESS");
}

void loop() {
   Vsetmsb = data[0][0]; 
   Vsetlsb = data[0][1];
   Vset = (Vsetmsb << 8) | Vsetlsb;  
    Isetmsb = data[0][2];
    Isetlsb = data[0][3];
    Iset = (Isetmsb << 8) | Isetlsb;

     control_1 = data[0][4];
     control_2 = data[0][5];
   if(control_1 == 0){
      Serial.print("Start charging");
     }
       else{
       Serial.print("Battery protection, Stop Charging");
       }

   if(control_2 == 0){
      Serial.print("Charging Mode");
     } 
       else{
       Serial.print("Heating Mode");     //Sebelum battery Li-Ion boleh di charge harus dipanaskan jika memang disuhu rendah <10 C
      }
}
